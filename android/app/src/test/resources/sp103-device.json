{
 "api": 2,
 "kind": "amplifier",
 "model": "Acoustic Solutions SP103",
 "name": "SP103-D4FE",
 "bridge_version": "c59be28d",
 "firmware": "alemser/sp103-mod",
 "features": [
  "control",
  "settings",
  "update",
  "wifi_setup"
 ],
 "state": [
  {
   "id": "power",
   "type": "enum",
   "values": [
    "on",
    "standby"
   ]
  },
  {
   "id": "lcd",
   "type": "lines",
   "label": "Display",
   "columns": 16
  },
  {
   "id": "volume_db",
   "type": "number",
   "label": "Volume",
   "unit": "dB"
  },
  {
   "id": "input_name",
   "type": "text",
   "label": "Input"
  },
  {
   "id": "bass_db",
   "type": "number",
   "label": "Bass",
   "unit": "dB"
  },
  {
   "id": "treble_db",
   "type": "number",
   "label": "Treble",
   "unit": "dB"
  },
  {
   "id": "balance.db",
   "type": "number",
   "label": "Balance",
   "unit": "dB"
  },
  {
   "id": "loudness",
   "type": "bool",
   "label": "Loudness"
  },
  {
   "id": "speakers",
   "type": "bool",
   "label": "Speakers"
  }
 ],
 "controls": [
  {
   "group": "power",
   "keys": [
    "power_toggle"
   ]
  },
  {
   "group": "volume",
   "steps": [
    {
     "target": "volume",
     "state": "volume_db",
     "label": "Volume"
    }
   ]
  },
  {
   "group": "input",
   "select": {
    "state": "input_id",
    "options": [
     {
      "id": "phono",
      "name": "PHONO",
      "key": "select_phono"
     },
     {
      "id": "tuner",
      "name": "TUNER",
      "key": "select_tuner"
     },
     {
      "id": "tape_aux",
      "name": "TAPE/AUX",
      "key": "select_tape_aux"
     },
     {
      "id": "cd",
      "name": "CD",
      "key": "select_cd"
     },
     {
      "id": "dvd",
      "name": "DVD",
      "key": "select_dvd"
     },
     {
      "id": "dab",
      "name": "DAB",
      "key": "select_dab"
     }
    ]
   }
  },
  {
   "group": "tone",
   "steps": [
    {
     "target": "bass",
     "state": "bass_db",
     "label": "Bass"
    },
    {
     "target": "treble",
     "state": "treble_db",
     "label": "Treble"
    },
    {
     "target": "balance",
     "state": "balance.db",
     "label": "Balance"
    }
   ]
  },
  {
   "group": "modes",
   "switches": [
    {
     "target": "loudness",
     "state": "loudness",
     "label": "Loudness"
    },
    {
     "target": "speakers",
     "state": "speakers",
     "label": "Speakers"
    }
   ]
  }
 ],
 "settings": [
  {
   "id": "inputs.PHONO",
   "type": "text",
   "label": "PHONO",
   "group": "Input names",
   "max": 16,
   "charset": "lcd",
   "placeholder": "PHONO",
   "hint": "Empty = the amp's own name. Up to 16 characters, no accents"
  },
  {
   "id": "inputs.TUNER",
   "type": "text",
   "label": "TUNER",
   "group": "Input names",
   "max": 16,
   "charset": "lcd",
   "placeholder": "TUNER"
  },
  {
   "id": "inputs.TAPE/AUX",
   "type": "text",
   "label": "TAPE/AUX",
   "group": "Input names",
   "max": 16,
   "charset": "lcd",
   "placeholder": "TAPE/AUX"
  },
  {
   "id": "inputs.CD",
   "type": "text",
   "label": "CD",
   "group": "Input names",
   "max": 16,
   "charset": "lcd",
   "placeholder": "CD"
  },
  {
   "id": "inputs.DVD",
   "type": "text",
   "label": "DVD",
   "group": "Input names",
   "max": 16,
   "charset": "lcd",
   "placeholder": "DVD"
  },
  {
   "id": "inputs.DAB",
   "type": "text",
   "label": "DAB",
   "group": "Input names",
   "max": 16,
   "charset": "lcd",
   "placeholder": "DAB"
  },
  {
   "id": "boot.0",
   "type": "text",
   "label": "Line 1",
   "group": "Boot screen",
   "max": 16,
   "charset": "lcd",
   "placeholder": "ACOUSTIC"
  },
  {
   "id": "boot.1",
   "type": "text",
   "label": "Line 2",
   "group": "Boot screen",
   "max": 16,
   "charset": "lcd",
   "placeholder": "SOLUTIONS"
  },
  {
   "id": "about.0",
   "type": "text",
   "label": "Line 1",
   "group": "About screen",
   "max": 16,
   "charset": "lcd",
   "placeholder": "Amplifier SP103"
  },
  {
   "id": "about.1",
   "type": "text",
   "label": "Line 2",
   "group": "About screen",
   "max": 16,
   "charset": "lcd",
   "placeholder": "SW version 1.0"
  },
  {
   "id": "vu.on",
   "type": "bool",
   "label": "VU meter while music plays",
   "group": "VU meter"
  },
  {
   "id": "vu.layout",
   "type": "enum",
   "label": "Layout",
   "group": "VU meter",
   "values": [
    "bars",
    "deck",
    "scale",
    "kx393"
   ],
   "labels": [
    "Thin bars",
    "Cassette deck",
    "Printed scale",
    "Yamaha KX-393"
   ],
   "when": {
    "vu.on": true
   }
  },
  {
   "id": "vu.relay",
   "type": "ip",
   "label": "Source (the VU relay's IP)",
   "group": "VU meter",
   "hint": "The board running sp103-vu-relay; the Pico does not resolve .local names"
  },
  {
   "id": "info.on",
   "type": "bool",
   "label": "Stylus and Bluetooth quality",
   "group": "Info screens"
  },
  {
   "id": "info.mode",
   "type": "enum",
   "label": "Show them",
   "group": "Info screens",
   "values": [
    "temp",
    "fixed"
   ],
   "labels": [
    "For a few seconds",
    "All the time"
   ],
   "when": {
    "info.on": true
   },
   "hint": "All the time: the VU meter is not shown"
  },
  {
   "id": "info.secs",
   "type": "int",
   "label": "Seconds on the display",
   "group": "Info screens",
   "min": 3,
   "max": 60,
   "step": 1,
   "when": {
    "info.on": true,
    "info.mode": "temp"
   },
   "hint": "Stylus: when you switch to a turntable input and when a record starts. Bluetooth: when it starts or the quality changes"
  },
  {
   "id": "info.show.stylus",
   "type": "bool",
   "label": "Stylus hours",
   "group": "Info screens",
   "hint": "On the turntable inputs",
   "when": {
    "info.on": true
   }
  },
  {
   "id": "info.show.quality",
   "type": "bool",
   "label": "Bluetooth quality",
   "group": "Info screens",
   "hint": "On DAB, with Bluetooth",
   "when": {
    "info.on": true
   }
  },
  {
   "id": "info.source",
   "type": "ip",
   "label": "Info source (IP)",
   "group": "Info screens",
   "hint": "Empty = the VU source",
   "when": {
    "info.on": true
   }
  },
  {
   "id": "info.turntable.PHONO",
   "type": "bool",
   "label": "PHONO",
   "group": "Turntable inputs",
   "when": {
    "info.on": true
   },
   "hint": "The stylus screen only appears on these"
  },
  {
   "id": "info.turntable.TUNER",
   "type": "bool",
   "label": "TUNER",
   "group": "Turntable inputs",
   "when": {
    "info.on": true
   }
  },
  {
   "id": "info.turntable.TAPE/AUX",
   "type": "bool",
   "label": "TAPE/AUX",
   "group": "Turntable inputs",
   "when": {
    "info.on": true
   }
  },
  {
   "id": "info.turntable.CD",
   "type": "bool",
   "label": "CD",
   "group": "Turntable inputs",
   "when": {
    "info.on": true
   }
  },
  {
   "id": "info.turntable.DVD",
   "type": "bool",
   "label": "DVD",
   "group": "Turntable inputs",
   "when": {
    "info.on": true
   }
  },
  {
   "id": "info.turntable.DAB",
   "type": "bool",
   "label": "DAB",
   "group": "Turntable inputs",
   "when": {
    "info.on": true
   }
  }
 ]
}
